# Practice on a phone held sideways (DPR 3): stage 9 from the stage grid, one shot by keys fast-forwarded, undo from the tray,
# then the pause panel: Help, Settings (left-handed controls on), Resume, Pause, Leave round.
# viewport 844x390@3
# Generated by tools/gen-plays.mjs from the rules (tools/plan.mjs).
until 600 Daily Challenge
frames 20
touch =Journey
until 120 Journey stages
frames 10
touch =Back
until 120 Select a mode
frames 10
touch =Practice
until 120 Practice stages
frames 10
touch =Stage 9
until 120 Collapse every Bumble
frames 20
key ArrowLeft 1
key ArrowDown 1
key ArrowDown 1
key ArrowDown 1
key ArrowDown 1
key ArrowDown 1
key Space 1
frames 5
key KeyS 1
frames 10
expect 4
save practice-after-shot
touch =Undo shot (practice)
frames 10
expect 5
save practice-undone
touch =Pause
until 60 Paused
frames 10
save practice-paused
touch =Help #2
until 60 Materials
frames 10
save practice-help
touch =Close
until 60 Paused
frames 10
touch =Settings
until 60 Left-handed controls
frames 10
touch =Left-handed controls
frames 10
save practice-settings
touch =Done
until 60 Paused
frames 10
touch =Resume
frames 20
save practice-lefty
touch =Pause
until 60 Paused
frames 10
touch =Leave round
until 60 Daily Challenge
frames 10
expect Practice
