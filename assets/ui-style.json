      "background": "$panel-bg",
      "radius": 14,
      "shadow": {
        "y": 12,
        "blur": 40,
        "color": "#00000080"
      },
      "padding": {
        "top": 24,
        "end": 28,
        "bottom": 24,
        "start": 28
