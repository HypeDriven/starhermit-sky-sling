      "background": "$toast-bg",
      "radius": 10,
      "shadow": {
        "y": 6,
        "blur": 20,
        "color": "#00000059"
      },
      "padding": {
        "top": 10,
        "end": 16,
        "bottom": 10,
        "start": 16
      }
    },
    ".page-bg": {
      "background": "#0e1a26",
      "radius": 0
    },
    ".btn": {
      "background": "$btn-bg",
      "border": {
        "width": 2,
        "color": "#00000000",
        "style": "solid"
      },
      "radius": 10,
      "padding": {
        "top": 8,
        "end": 16,
        "bottom": 8,
        "start": 16
      },
      "minWidth": 44,
      "minHeight": 44,
      "text": {
        "color": "$panel-fg",
        "size": 16,
        "align": "center"
      },
      "hovered": {
        "background": "$btn-bg-hover"
      },
      "focusVisible": {
        "focusRing": {
          "width": 3,
          "color": "$focus-ring",
          "offset": 2
        }
      },
      "disabled": {
        "opacity": 0.45
      }
    },
    ".btn-primary": {
      "background": "$accent",
      "border": {
        "width": 2,
        "color": "#00000000",
        "style": "solid"
      },
      "radius": 10,
      "padding": {
        "top": 8,
        "end": 16,
