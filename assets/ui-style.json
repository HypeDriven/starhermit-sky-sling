        "bottom": 10,
        "start": 12
      }
    },
    ".fieldset": {
      "border": {
        "width": 1,
        "color": "#ffffff33",
        "style": "solid"
      },
      "radius": 8,
      "padding": {
        "top": 8,
        "end": 12,
        "bottom": 8,
        "start": 12
      }
    },
